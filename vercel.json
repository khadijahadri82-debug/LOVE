{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "app.js",
      "use": "@vercel/static"
    },
    {
      "src": "chat.js",
      "use": "@vercel/static"
    },
    {
      "src": "error-messages.js",
      "use": "@vercel/static"
    },
    {
      "src": "styles.css",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/private-chat",
      "destination": "/index.html"
    },
    {
      "source": "/private-chat/",
      "destination": "/index.html"
    }
  ]
}
