# Generate each token with: node -p "require('node:crypto').randomBytes(32).toString('hex')"
# Keep these participant-specific tokens private; do not put real values in frontend code.
CHAT_TOKEN_1=replace-with-a-unique-64-character-hex-token
CHAT_TOKEN_2=replace-with-a-different-64-character-hex-token
CHAT_USER_1=participant-one
CHAT_PASSWORD_1=replace-with-a-unique-password-at-least-12-characters
CHAT_NAME_1=Participant One
CHAT_USER_2=participant-two
CHAT_PASSWORD_2=replace-with-a-different-password-at-least-12-characters
CHAT_NAME_2=Participant Two
CHAT_SESSION_SECRET=replace-with-at-least-32-random-characters
